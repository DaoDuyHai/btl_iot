{
  "name": "library-kiosk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Smart Library Kiosk System - IoT Self-Service Station",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install && npm --prefix tools/device-simulator install && node -e \"const fs=require('fs'); if(!fs.existsSync('server/.env')) fs.copyFileSync('server/.env.example','server/.env'); if(!fs.existsSync('client/.env')) fs.copyFileSync('client/.env.example','client/.env'); console.log('Setup completed! Ready to run.');\"",
    "seed": "npm --prefix server run seed",
    "seed:ai": "npm --prefix server run seed:ai",
    "ai:dev": "ai-service\\venv\\Scripts\\python.exe -m uvicorn main:app --host 0.0.0.0 --port 8000 --app-dir ai-service --reload",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "sim": "npm --prefix tools/device-simulator start",
    "sim:local": "npm --prefix tools/device-simulator run start:local",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "npm --prefix server test",
    "test:coverage": "npm --prefix server run test:coverage"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "iot",
    "esp32",
    "rfid",
    "library",
    "kiosk",
    "mqtt"
  ],
  "devDependencies": {
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
